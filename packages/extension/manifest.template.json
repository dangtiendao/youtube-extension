{
  "manifest_version": 3,
  "name": "TubeVault — YouTube Video, Album & Channel Downloader",
  "short_name": "TubeVault",
  "version": "1.0.0",
  "description": "Tải video YouTube 4K, Album/Playlist nhạc và toàn bộ Kênh qua Local Engine bảo mật.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mở TubeVault Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://music.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
